# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
# In production on Neon:
# DATABASE_URL uses the connection pooler (port 6543) with ?sslmode=require
DATABASE_URL=postgresql://sprintnest:sprintnest@localhost:5432/sprintnest
# DIRECT_URL connects directly (port 5432) for schema migrations (bypassing the pooler).
# In local development this can be identical to DATABASE_URL.
DIRECT_URL=postgresql://sprintnest:sprintnest@localhost:5432/sprintnest

# Redis
# Production must use the hosted endpoint (localhost is rejected when NODE_ENV=production).
REDIS_URL=redis://localhost:6379

# JWT
# In production this must be a unique secret of at least 32 characters.
# The value below is a development placeholder and is rejected when NODE_ENV=production.
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

# Email
# `console` logs emails to stdout (development default).
# `resend` sends through the Resend REST API and requires RESEND_API_KEY.
# Production (NODE_ENV=production) requires EMAIL_PROVIDER=resend.
EMAIL_PROVIDER=console

# Server-side only. Never prefix with VITE_ and never expose to the client.
# Required when EMAIL_PROVIDER=resend; startup validation fails without it.
RESEND_API_KEY=

# Sender address for outgoing mail. Accepts `user@domain` or `Name <user@domain>`.
# Resend requires either a verified domain or onboarding@resend.dev.
# Defaults to "SprintNest <onboarding@resend.dev>" when unset.
RESEND_FROM_EMAIL=

# App
# Public base URL. Invitation and password-reset email links are built from this,
# so it must match the deployed origin exactly (localhost is rejected in production).
APP_URL=http://localhost:3000

# Optional: directory containing the built React SPA that Express serves.
# Defaults to ../client/dist relative to the server package.
CLIENT_DIST_PATH=
